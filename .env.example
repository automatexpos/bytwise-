# Supabase configuration
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI API key (optional, AI powered descriptions are disabled without it)
GEMINI_API_KEY=your-gemini-api-key-here

# Cloudinary server side credentials (used for both signed upload and delete)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Secret key used to sign the session cookie (holds in-progress signup/OTP data).
# Set this to a long random string in production.
SESSION_SECRET_KEY=change-me-to-a-random-secret

# Gmail SMTP credentials for sending signup verification (OTP) emails.
# GMAIL_SMTP_USER must be the real Google account that owns the app password
# (an alias added via Gmail's "Send mail as" cannot log in itself).
# GMAIL_SMTP_PASSWORD must be a Gmail "App Password", not your normal password
# (requires 2-Step Verification on the Google account): https://myaccount.google.com/apppasswords
# GMAIL_SMTP_FROM is optional: set it to a verified "Send mail as" alias to have
# OTP emails appear from that address instead of GMAIL_SMTP_USER.
GMAIL_SMTP_USER=your-real-gmail-account@gmail.com
GMAIL_SMTP_PASSWORD=your-16-char-app-password
GMAIL_SMTP_FROM=Your Name <alias@yourdomain.com>

# Restaurant recommendation chatbot backend (separate Flask + Ollama service).
# No environment variable needed here anymore. The app reads the current
# Cloudflare Tunnel URL from the `cloudflare_url` table in Supabase on each
# request instead, since that URL changes every time the tunnel restarts.
# The widget stays hidden until that table has a row with a url in it.
