# Supabase configuration
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI API key (optional, AI powered descriptions are disabled without it)
GEMINI_API_KEY=your-gemini-api-key-here

# Cloudinary server side credentials (used for both signed upload and delete)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Restaurant recommendation chatbot backend (separate Flask + Ollama service).
# Point this at your Cloudflare Tunnel URL while Ollama and Flask run on your
# own machine, e.g. https://random-words-1234.trycloudflare.com
# Leave empty to hide the chat widget entirely.
CHATBOT_API_URL=
